{
 "uid": "infrawatch-overview",
 "title": "InfraWatch — Motor de monitoramento",
 "tags": [
  "infrawatch"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Verificações em andamento",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "infrawatch-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "infrawatch_engine_checks_inflight",
     "legendFormat": "em andamento"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Verificações/min",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "infrawatch-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(infrawatch_engine_checks_executed_total[5m]))*60",
     "legendFormat": "exec/min"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Alertas disparados (1h)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "infrawatch-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(infrawatch_engine_alerts_triggered_total[1h]))",
     "legendFormat": "alertas"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Entregas externas falhas (1h)",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "infrawatch-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(infrawatch_engine_deliveries_failed_total[1h]))",
     "legendFormat": "falhas"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Verificações executadas por resultado",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "infrawatch-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (result) (rate(infrawatch_engine_checks_executed_total[5m]))",
     "legendFormat": "{{result}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Duração das verificações (p50/p95/máx)",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "infrawatch-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(infrawatch_engine_checks_duration_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(infrawatch_engine_checks_duration_seconds_bucket[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "max(infrawatch_engine_checks_duration_seconds_max)",
     "legendFormat": "máx"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Transições de status",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "infrawatch-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (to) (rate(infrawatch_engine_status_transitions_total[5m]))*60",
     "legendFormat": "→ {{to}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Alertas e incidentes",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "infrawatch-prometheus"
   },
