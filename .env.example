# Copie para .env e ajuste se necessário. Todos os valores têm padrão seguro para uso local.

# PostgreSQL (porta 5433 no host para não conflitar com instalações locais)
POSTGRES_DB=infrawatch
POSTGRES_USER=infrawatch
POSTGRES_PASSWORD=infrawatch
POSTGRES_PORT=5433

# API Spring Boot
API_PORT=8080
MANAGEMENT_PORT=8081
INFRAWATCH_SEED_ENABLED=true

# Frontend
WEB_PORT=5174

# Agente de demonstração (Fase 2). Troque em qualquer ambiente que não seja local.
INFRAWATCH_DEMO_AGENT_TOKEN=iwa_demoagnt.local-demo-token-change-me-0001

# Integrações externas (Fase 5). Desativadas por padrão: entregas ficam registradas como "ignoradas" e nada sai da máquina.
# Para testar com o Mailpit local: suba o perfil observability e defina INFRAWATCH_INTEGRATIONS_ENABLED=true e INFRAWATCH_SMTP_HOST=mailpit.
INFRAWATCH_INTEGRATIONS_ENABLED=false
INFRAWATCH_SMTP_HOST=
INFRAWATCH_SMTP_PORT=1025

# Observabilidade (perfil "observability": docker compose --profile observability up -d)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Amostragem de traces OTLP (0.0 = desligado). Ex.: 0.1 envia 10% das requisições ao otel-collector.
INFRAWATCH_TRACING_SAMPLING=0.0
